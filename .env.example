# FinFlow — пример переменных окружения.
# Скопируйте в .env и при необходимости измените значения.
# Значения ниже совпадают с дефолтами в docker-compose.yml — для
# локального стенда менять их не обязательно.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=finflow
DB_PASSWORD=finflow123
DB_NAME=finflow_db

# ── Генератор данных ───────────────────────────────────────────────────────
TRANSACTIONS_PER_SECOND=2

# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
POLL_INTERVAL_SECONDS=5

# ── Consumer: статистический fraud-детект ──────────────────────────────────
# Порог Z-оценки для пометки аномальной транзакции (3.0 ≈ правило трёх сигм)
Z_THRESHOLD=3.0
SUMMARY_EVERY=50

# ── Spark ──────────────────────────────────────────────────────────────────
BRONZE_PATH=/data/bronze
SILVER_PATH=/data/silver
SPARK_JARS=/opt/spark/jars/postgresql.jar
